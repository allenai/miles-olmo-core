index 0000000..cff4b90
--- /dev/null
+++ b/test/manual/olmicro/probe_distribution.py
@@ -0,0 +1,166 @@
+"""Compare full next-token distributions on identical fixed prefixes.
+
+This complements, rather than overrides, the strict selected-token gate.
+"""
+
+import argparse
+import hashlib
+import importlib
+import json
+from pathlib import Path
+
+import torch
+from probe_backend import _inputs, _make_engine
+
+
+def probe(args):
+    args.full_distribution = True
+    engine, _ = _make_engine(args)
+    try:
+        tokenizer = importlib.import_module(
+            "transformers"
+        ).AutoTokenizer.from_pretrained(args.model)
+        prompts, fixed = _inputs(tokenizer, args.lengths)
+        # Score every teacher-forced continuation position, not only endpoints.
+        prefixes = [
+            f[:stop]
+            for p, f in zip(prompts, fixed, strict=True)
+            for stop in range(len(p), len(f) + 1)
+        ]
+        if max(map(len, prompts)) >= 26:
+            prefixes.append(max(prompts, key=len)[:26])
+        prefixes = [list(ids) for ids in dict.fromkeys(map(tuple, prefixes))]
+        vocab = json.loads((Path(args.model) / "config.json").read_text())["vocab_size"]
+        vectors = []
+        # One request at a time bounds transport memory for 100k-way scores.
+        for index, ids in enumerate(prefixes, 1):
+            if args.backend == "sglang":
+                output = engine.generate(
+                    input_ids=ids,
+                    sampling_params={
+                        "temperature": 0,
+                        "max_new_tokens": 1,
+                        "ignore_eos": True,
+                    },
+                    return_logprob=True,
+                    logprob_start_len=-1,
+                    token_ids_logprob=list(range(vocab)),
+                )
+                rows = output["meta_info"]["output_token_ids_logprobs"][0]
+                scores = {row[1]: row[0] for row in rows}
+            else:
+                vl = importlib.import_module("vllm")
+                output = engine.generate(
+                    [{"prompt_token_ids": ids}],
+                    vl.SamplingParams(
+                        temperature=0,
+                        max_tokens=1,
+                        ignore_eos=True,
+                        logprobs=-1,
+                        detokenize=False,
+                    ),
+                    use_tqdm=False,
+                )[0]
+                scores = {
+                    token: row.logprob
+                    for token, row in output.outputs[0].logprobs[0].items()
+                }
+            if set(scores) != set(range(vocab)):
+                raise ValueError("Backend did not return exactly the full vocabulary")
+            vector = torch.tensor(
+                [scores[i] for i in range(vocab)], dtype=torch.float32
+            )
+            if not vector.isfinite().all():
+                raise ValueError("Nonfinite full-vocabulary scores")
+            vectors.append(vector)
+            print(
+                f"{args.backend}: completed distribution {index}/{len(prefixes)} "
+                f"at {len(ids)} tokens",
+                flush=True,
+            )
+        record = {
+            "backend": args.backend,
+            "model": args.model,
+            "config_sha256": hashlib.sha256(
+                (Path(args.model) / "config.json").read_bytes()
+            ).hexdigest(),
+            "gpu": torch.cuda.get_device_name(),
+            "torch": str(torch.__version__),
+            "attention_backend": getattr(args, "attention_backend", "triton")
+            if args.backend == "sglang"
+            else "vllm-auto",
+            "input_ids": prefixes,
+            "logprobs": torch.stack(vectors),
+        }
+        temporary = Path(args.output).with_suffix(".partial")
+        torch.save(record, temporary)
+        temporary.replace(args.output)
+    finally:
+        if args.backend == "sglang":
+            engine.shutdown()
+
+
+def compare(a, b):
+    for key in ("model", "config_sha256", "input_ids"):
+        if a[key] != b[key]:
+            raise ValueError(f"Distribution identity mismatch: {key}")
+    x, y = a["logprobs"].double(), b["logprobs"].double()
+    if x.shape != y.shape or x.ndim != 2 or x.numel() == 0:
+        raise ValueError("Invalid distribution shapes")
+    if not x.isfinite().all() or not y.isfinite().all():
+        raise ValueError("Nonfinite distribution")
+    p, q = x.exp(), y.exp()
+    if max((p.sum(-1) - 1).abs().max(), (q.sum(-1) - 1).abs().max()) > 1e-4:
+        raise ValueError("Backend scores are not normalized log probabilities")
+    # Remove only softmax summation roundoff before measuring KL.
+    x, y = x.log_softmax(-1), y.log_softmax(-1)
+    p, q = x.exp(), y.exp()
+    forward = (p * (x - y)).sum(-1)
+    reverse = (q * (y - x)).sum(-1)
+    tv = (p - q).abs().sum(-1) / 2
+    return {
+        "passed": bool(max(forward.max(), reverse.max()) <= 1e-3),
+        "max_sglang_to_vllm_kl": float(forward.max()),
+        "max_vllm_to_sglang_kl": float(reverse.max()),
+        "max_total_variation": float(tv.max()),
+        "cases": [
+            {
+                "tokens": len(ids),
+                "forward_kl": float(f),
+                "reverse_kl": float(r),
+                "total_variation": float(t),
+            }
+            for ids, f, r, t in zip(a["input_ids"], forward, reverse, tv, strict=True)
+        ],
+    }
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--backend", choices=("sglang", "vllm"))
+    parser.add_argument("--model")
+    parser.add_argument("--output", required=True)
+    parser.add_argument("--concurrency", type=int, default=16)
+    parser.add_argument(
+        "--attention-backend", choices=("triton", "flashinfer", "fa3"), default="triton"
+    )
+    parser.add_argument(
+        "--lengths", nargs="+", type=int, default=[1, 3, 31, 127, 511, 2047, 3071]
+    )
+    parser.add_argument("--compare", nargs=2)
+    args = parser.parse_args()
+    if args.compare:
+        report = compare(*(torch.load(p, weights_only=True) for p in args.compare))
+        Path(args.output).write_text(json.dumps(report, indent=2) + "\n")
+        if not report["passed"]:
+            raise SystemExit(1)
+    elif args.backend and args.model:
+        probe(args)
+    else:
+        parser.error(
+            "Supply --compare LEFT RIGHT or --backend BACKEND --model CHECKPOINT"
+        )
+
+
+if __name__ == "__main__":
+    main()
