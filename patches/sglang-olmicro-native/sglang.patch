@@ -0,0 +1,18 @@
+"""The fused native activation must preserve eager BF16 SiLU rounding."""
+
+import pytest
+import torch
+from sglang.srt.models.mainline_ladder import MainlineLadderSiluAndMul
+
+
+@pytest.mark.parametrize("tokens,width", [(1, 5120), (7, 5120), (31, 8192)])
+def test_swiglu_rounds_silu_before_multiply(tokens, width):
+    torch.manual_seed(41)
+    x = torch.randn(tokens, 2 * width, device="cuda", dtype=torch.bfloat16) * 4
+    gate, up = x.chunk(2, dim=-1)
+    expected = torch.nn.functional.silu(gate) * up
+    actual = MainlineLadderSiluAndMul()(x)
+    assert actual.dtype == torch.bfloat16
+    assert (actual == expected).float().mean().item() > 0.9999
+    without_rounding = (torch.nn.functional.silu(gate.float()) * up.float()).bfloat16()
+    assert (without_rounding != expected).float().mean().item() > 0.1
