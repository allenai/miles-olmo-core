@@ -0,0 +1,83 @@
+"""GPU regression for Olmicro's beta=2 sigmoid(b), including state-slot isolation."""
+
+import pytest
+import torch
+from sglang.kernels.ops.attention.fla.fused_gdn_gating import fused_gdn_gating
+from sglang.kernels.ops.attention.fla.fused_recurrent import (
+    fused_recurrent_gated_delta_rule_packed_decode,
+)
+from torch.nn import functional as F
+
+
+@pytest.mark.parametrize("beta_scale", [1.0, 2.0])
+@pytest.mark.parametrize("heads,kv_heads", [(2, 2), (4, 2)])
+def test_batched_recurrent_update_and_state_slot_isolation(beta_scale, heads, kv_heads):
+    torch.manual_seed(7)
+    batch, key_dim, value_dim = 3, 128, 64
+    device = "cuda"
+    slots = torch.tensor([5, 1, 8], device=device)
+    q = torch.randn(batch, kv_heads, key_dim, device=device, dtype=torch.bfloat16)
+    k = torch.randn_like(q)
+    v = torch.randn(batch, heads, value_dim, device=device, dtype=torch.bfloat16)
+    a = torch.randn(batch, heads, device=device, dtype=torch.bfloat16)
+    b = torch.randn_like(a)
+    A = torch.randn(heads, device=device)
+    dt = torch.randn(heads, device=device, dtype=torch.bfloat16)
+    state = torch.randn(10, heads, value_dim, key_dim, device=device)
+    before = state.clone()
+    packed = torch.cat([x.flatten(1) for x in (q, k, v)], dim=-1)
+    output = torch.empty(
+        batch, 1, heads, value_dim, device=device, dtype=torch.bfloat16
+    )
+    fused_recurrent_gated_delta_rule_packed_decode(
+        packed,
+        a,
+        b,
+        A,
+        dt,
+        key_dim**-0.5,
+        state,
+        output,
+        slots,
+        use_qk_l2norm_in_kernel=True,
+        beta_scale=beta_scale,
+    )
+    q = (
+        q.float() / (q.float().square().sum(-1, keepdim=True) + 1e-6).sqrt()
+    ).repeat_interleave(heads // kv_heads, dim=1)
+    k = (
+        k.float() / (k.float().square().sum(-1, keepdim=True) + 1e-6).sqrt()
+    ).repeat_interleave(heads // kv_heads, dim=1)
+    gate = (-A.exp() * F.softplus(a.float() + dt.float())).exp()
+    expected = before[slots] * gate[..., None, None]
+    beta = b.float().sigmoid()
+    if beta_scale == 1.0:
+        beta = beta.to(b.dtype).float()
+    beta *= beta_scale
+    delta = (v.float() - torch.einsum("bhvk,bhk->bhv", expected, k)) * beta[..., None]
+    expected += delta[..., None] * k[..., None, :]
+    expected_output = torch.einsum("bhvk,bhk->bhv", expected, q) * key_dim**-0.5
+    torch.testing.assert_close(state[slots], expected, atol=5e-5, rtol=2e-4)
+    torch.testing.assert_close(
+        output[:, 0].float(), expected_output, atol=0.02, rtol=0.02
+    )
+    untouched = torch.tensor([0, 2, 3, 4, 6, 7, 9], device=device)
+    torch.testing.assert_close(state[untouched], before[untouched], atol=0, rtol=0)
+
+
+@pytest.mark.parametrize("beta_scale", [1.0, 2.0])
+def test_prefill_gating_preserves_fp32_doubled_beta(beta_scale):
+    a = torch.tensor([[0.3, -1.2, 0.5, 2.1]], device="cuda", dtype=torch.bfloat16)
+    b = torch.tensor([[-4.2, -0.5, 0.3, 2.1]], device="cuda", dtype=torch.bfloat16)
+    decay = torch.tensor([-1.0, 0.0, 1.0, -0.5], device="cuda")
+    dt = torch.zeros(4, device="cuda", dtype=torch.bfloat16)
+    g, beta = fused_gdn_gating(decay, a, b, dt, beta_scale=beta_scale)
+    expected = b.float().sigmoid()
+    if beta_scale == 1.0:
+        expected = expected.to(b.dtype).float()
+    expected *= beta_scale
+    assert beta.dtype == torch.float32
+    torch.testing.assert_close(beta[0], expected, rtol=1e-6, atol=1e-7)
+    torch.testing.assert_close(
+        g[0], -decay.exp() * F.softplus(a.float()), rtol=1e-6, atol=1e-7
+    )
