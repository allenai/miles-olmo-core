+++ b/python/sglang/srt/configs/mainline_ladder.py
@@ -0,0 +1,30 @@
+"""Olmicro release configuration, using SGLang's managed GDN state layout."""
+
+from sglang.srt.configs.qwen3_next import Qwen3NextConfig
+
+
+class MainlineLadderConfig(Qwen3NextConfig):
+    model_type = "mainline_ladder"
+    has_no_defaults_at_init = True
+
+    def __init__(self, layer_types=None, **kwargs):
+        if not layer_types or any(
+            kind not in ("linear_attention", "full_attention") for kind in layer_types
+        ):
+            raise ValueError("Olmicro requires an explicit hybrid layer_types list")
+        kwargs.setdefault("num_experts", 0)
+        kwargs.setdefault("num_experts_per_tok", 0)
+        super().__init__(layer_types=layer_types, **kwargs)
+        self.mamba_ssm_dtype = "float32"
+        if len(layer_types) != self.num_hidden_layers:
+            raise ValueError("layer_types must describe every decoder layer")
+        self.layer_types = list(layer_types)
+        self.linear_allow_neg_eigval = kwargs.get("linear_allow_neg_eigval", True)
+        self.embed_scale = kwargs.get("embed_scale", self.hidden_size**0.5)
+        self.embedding_norm_eps = kwargs.get("embedding_norm_eps", self.rms_norm_eps)
+        self.use_head_qk_norm = kwargs.get("use_head_qk_norm", True)
+        self.use_attention_gate = kwargs.get("use_attention_gate", True)
+
+    @property
+    def layers_block_type(self):
+        return ["attention" if k == "full_attention" else k for k in self.layer_types]
