@@ -0,0 +1,91 @@
+"""GPU check that release-name updates refresh fused projection/filter buffers."""
+
+import pytest
+import torch
+from sglang.srt.configs.mainline_ladder import MainlineLadderConfig
+from sglang.srt.models.mainline_ladder import (
+    MainlineLadderForCausalLM,
+    MainlineLadderGDN,
+    MainlineLadderMLP,
+)
+from torch import nn
+
+
+def test_release_convolution_names_and_live_repacking():
+    config = MainlineLadderConfig(
+        layer_types=["linear_attention"],
+        num_hidden_layers=1,
+        hidden_size=16,
+        linear_num_key_heads=2,
+        linear_num_value_heads=2,
+        linear_key_head_dim=16,
+        linear_value_head_dim=16,
+        linear_conv_kernel_dim=4,
+    )
+    with torch.device("cuda"), torch.no_grad():
+        old_dtype = torch.get_default_dtype()
+        torch.set_default_dtype(torch.bfloat16)
+        try:
+            holder = nn.Module()
+            holder.layer = MainlineLadderGDN(config, 0)
+        finally:
+            torch.set_default_dtype(old_dtype)
+        names = [f"layer.{part}_conv1d.weight" for part in ("q", "k", "v")]
+        params = dict(holder.named_parameters())
+        assert all(name in params for name in names)
+        for version in (1, 3):
+            updates = [
+                (name, torch.full_like(params[name], version + i))
+                for i, name in enumerate(names)
+            ]
+            loaded = MainlineLadderForCausalLM.load_weights(holder, updates)
+            assert loaded == set(names)
+            expected = torch.cat([weight for _, weight in updates]).squeeze(1)
+            torch.testing.assert_close(
+                holder.layer.attn.conv_weights, expected, rtol=0, atol=0
+            )
+        previous_qkv = holder.layer._qkv_weight.clone()
+        q_weight = torch.full_like(holder.layer.q_proj.weight, 4)
+        MainlineLadderForCausalLM.load_weights(
+            holder, [("layer.q_proj.weight", q_weight)]
+        )
+        q_rows = q_weight.shape[0]
+        torch.testing.assert_close(
+            holder.layer._qkv_weight[:q_rows], q_weight, rtol=0, atol=0
+        )
+        torch.testing.assert_close(
+            holder.layer._qkv_weight[q_rows:], previous_qkv[q_rows:], rtol=0, atol=0
+        )
+        with pytest.raises(ValueError, match="Unexpected"):
+            MainlineLadderForCausalLM.load_weights(holder, [("unknown", expected)])
+
+
+def test_partial_mlp_publication_changes_forward():
+    config = MainlineLadderConfig(
+        layer_types=["linear_attention"],
+        num_hidden_layers=1,
+        hidden_size=16,
+        intermediate_size=32,
+    )
+    holder = nn.Module()
+    holder.layer = MainlineLadderMLP(config).to(device="cuda", dtype=torch.bfloat16)
+    torch.manual_seed(53)
+    weights = [
+        (name, torch.randn_like(parameter) * 0.1)
+        for name, parameter in holder.named_parameters()
+    ]
+    MainlineLadderForCausalLM.load_weights(holder, weights)
+    x = torch.randn(7, 16, device="cuda", dtype=torch.bfloat16)
+    before = holder.layer(x)
+    replacement = torch.full_like(holder.layer.gate_proj.weight, 0.25)
+    MainlineLadderForCausalLM.load_weights(
+        holder, [("layer.gate_proj.weight", replacement)]
+    )
+    actual = holder.layer(x)
+    gate = nn.functional.linear(x, replacement)
+    up = nn.functional.linear(x, holder.layer.up_proj.weight)
+    expected = nn.functional.linear(
+        nn.functional.silu(gate) * up, holder.layer.down_proj.weight
+    )
+    torch.testing.assert_close(actual, expected, rtol=0, atol=0)
+    assert not torch.equal(before, actual)
