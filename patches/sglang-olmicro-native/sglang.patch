+import copy
+import importlib.util
+from pathlib import Path
+
+import pytest
+
+spec = importlib.util.spec_from_file_location(
+    "probe_backend", Path(__file__).with_name("probe_backend.py")
+)
+probe = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(probe)
+
+
+def _record():
+    row = {
+        "input_ids": [1, 2, 3],
+        "input_logprobs": [None, -1.0, -2.0],
+        "output_ids": [4, 5],
+    }
+    return {
+        "status": "PASSED",
+        "model": "/same/checkpoint",
+        "config_sha256": "same",
+        "fixed_continuation": [row],
+        "greedy": [row],
+    }
+
+
+def test_selected_probabilities_are_compared_on_identical_inputs():
+    left, right = _record(), _record()
+    right["fixed_continuation"][0]["input_logprobs"][2] -= 0.09
+    assert not probe._compare(left, right)["passed"]
+
+
+def test_greedy_divergence_is_visible_separately():
+    left, right = _record(), copy.deepcopy(_record())
+    right["greedy"][0]["output_ids"] = [4, 6]
+    report = probe._compare(left, right)
+    assert report["passed"]
+    assert report["greedy_exact_matches"] == [False]
+
+
+@pytest.mark.parametrize("value", [None, float("nan"), float("inf")])
+def test_missing_or_nonfinite_scores_fail_closed(value):
+    right = _record()
+    right["fixed_continuation"][0]["input_logprobs"][1] = value
+    with pytest.raises(ValueError, match="Missing or nonfinite"):
+        probe._compare(_record(), right)
+
+
+def test_mismatched_checkpoint_and_inputs_are_rejected():
+    right = _record()
+    right["config_sha256"] = "different"
+    with pytest.raises(ValueError, match="checkpoint"):
+        probe._compare(_record(), right)
+    right = _record()
+    right["fixed_continuation"][0]["input_ids"][1] = 6
+    with pytest.raises(ValueError, match="tokenized inputs"):
+        probe._compare(_record(), right)
+
+
+@pytest.mark.parametrize("key,value", [("status", "FAILED"), ("model", "/other")])
+def test_incomplete_or_different_checkpoint_probes_are_rejected(key, value):
+    right = _record()
+    right[key] = value
+    with pytest.raises(ValueError):
+        probe._compare(_record(), right)
