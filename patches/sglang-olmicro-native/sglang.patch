+"""Record identical Olmicro inputs in native SGLang and vLLM.
+
+Run separately in each backend's pinned environment, on the same GPU class:
+  python probe_backend.py --backend sglang --model CHECKPOINT --output sg.json
+  python probe_backend.py --backend vllm --model CHECKPOINT --output vl.json
+  python probe_backend.py --compare sg.json vl.json --output parity.json
+
+Selected-token prompt probabilities use FIXED continuations, so a greedy decode
+branch cannot accidentally turn a probability comparison into different inputs.
+No reference-backbone plugin is loaded by the native SGLang probe.
+"""
+
+import argparse
+import hashlib
+import importlib
+import json
+import math
+import os
+import time
+from pathlib import Path
+
+import torch
+
+
+def _inputs(tokenizer, lengths):
+    unit = tokenizer.encode(
+        "Question: What is 12 plus 30? Answer: ", add_special_tokens=False
+    )
+    suffix = tokenizer.encode("The answer is 42.\n", add_special_tokens=False)
+    prompts = [(unit * (n // len(unit) + 1))[:n] for n in lengths]
+    return prompts, [p + suffix for p in prompts]
+
+
+def _sg_generate(engine, prompts, count):
+    outputs = engine.generate(
+        input_ids=prompts,
+        sampling_params={"temperature": 0, "max_new_tokens": count, "ignore_eos": True},
+        return_logprob=True,
+        logprob_start_len=0,
+    )
+    records = []
+    for prompt, output in zip(prompts, outputs, strict=True):
+        meta = output["meta_info"]
+        rows = meta["input_token_logprobs"]
+        if len(rows) != len(prompt) or [r[1] for r in rows] != prompt:
+            raise AssertionError(
+                "SGLang input logprobs do not align with supplied token IDs"
+            )
+        records.append(
+            {
+                "input_ids": prompt,
+                "input_logprobs": [r[0] for r in rows],
+                "output_ids": [r[1] for r in meta["output_token_logprobs"]],
+                "output_logprobs": [r[0] for r in meta["output_token_logprobs"]],
+            }
+        )
+    return records
+
+
+def _vl_generate(engine, prompts, count):
+    vllm = importlib.import_module("vllm")
+    outputs = engine.generate(
+        [{"prompt_token_ids": p} for p in prompts],
+        vllm.SamplingParams(
+            temperature=0,
+            max_tokens=count,
+            ignore_eos=True,
+            prompt_logprobs=1,
+            logprobs=1,
+        ),
+        use_tqdm=False,
+    )
+    records = []
+    for prompt, output in zip(prompts, outputs, strict=True):
+        generated = output.outputs[0]
+        records.append(
+            {
+                "input_ids": prompt,
+                "input_logprobs": [
+                    None if row is None else row[token].logprob
+                    for token, row in zip(prompt, output.prompt_logprobs, strict=True)
+                ],
+                "output_ids": list(generated.token_ids),
+                "output_logprobs": [
+                    row[token].logprob
+                    for token, row in zip(
+                        generated.token_ids, generated.logprobs, strict=True
+                    )
+                ],
+            }
+        )
+    return records
+
+
+def _make_engine(args):
+    os.environ.pop("SGLANG_EXTERNAL_MODEL_PACKAGE", None)
+    os.environ.pop("MILES_HYBRID_REFERENCE_BACKBONE", None)
+    if args.backend == "sglang":
+        sg = importlib.import_module("sglang")
+        engine = sg.Engine(
+            model_path=args.model,
+            dtype="bfloat16",
+            tp_size=1,
+            context_length=4096,
+            attention_backend=getattr(args, "attention_backend", "triton"),
+            disable_cuda_graph=True,
+            disable_radix_cache=True,
+            chunked_prefill_size=-1,
+            max_running_requests=args.concurrency,
+            mem_fraction_static=0.6,
+            random_seed=1,
+            linear_attn_backend="triton",
+            linear_attn_decode_backend="triton",
+            linear_attn_prefill_backend="triton",
+        )
+        generate = _sg_generate
+    elif args.backend == "vllm":
+        vl = importlib.import_module("vllm")
+        engine = vl.LLM(
+            model=args.model,
+            dtype="bfloat16",
+            tensor_parallel_size=1,
+            max_model_len=4096,
+            enforce_eager=True,
+            enable_prefix_caching=False,
+            max_num_seqs=args.concurrency,
+            gpu_memory_utilization=0.6,
+            mamba_ssm_cache_dtype="float32",
+            trust_remote_code=True,
+            seed=1,
+            max_logprobs=-1 if getattr(args, "full_distribution", False) else 20,
+        )
+        generate = _vl_generate
+    else:
+        raise ValueError(args.backend)
+    return engine, generate
+
+
+def _probe(args):
+    started = time.monotonic()
+    engine, generate = _make_engine(args)
+    tokenizer = importlib.import_module("transformers").AutoTokenizer.from_pretrained(
+        args.model
+    )
+    prompts, fixed = _inputs(tokenizer, args.lengths)
+    result = {
+        "backend": args.backend,
+        "model": args.model,
+        "config_sha256": hashlib.sha256(
+            (Path(args.model) / "config.json").read_bytes()
+        ).hexdigest(),
+        "gpu": torch.cuda.get_device_name(),
+        "torch": torch.__version__,
+        "concurrency": args.concurrency,
+        "attention_backend": getattr(args, "attention_backend", "triton")
+        if args.backend == "sglang"
+        else "vllm-auto",
+        "startup_seconds": time.monotonic() - started,
+        "status": "RUNNING",
+    }
+    Path(args.output).write_text(json.dumps(result, indent=2))
+    try:
+        result["fixed_continuation"] = generate(engine, fixed, 1)
+        start = time.monotonic()
+        result["greedy"] = generate(engine, prompts, args.decode_tokens)
+        result["batch_seconds"] = time.monotonic() - start
+        result["output_tokens_per_second"] = (
+            sum(len(r["output_ids"]) for r in result["greedy"])
+            / result["batch_seconds"]
+        )
+        # More requests than slots, unequal lengths, then reordered slot reuse.
+        queued = [prompts[i % len(prompts)] for i in range(args.concurrency + 3)]
+        result["queued"] = generate(engine, queued, 8)
+        for i, row in enumerate(result["queued"]):
+            if (
+                row["output_ids"]
+                != result["greedy"][i % len(prompts)]["output_ids"][:8]
+            ):
+                raise AssertionError("Queued scheduling changed greedy outputs")
+        result["reused"] = generate(engine, list(reversed(prompts)), args.decode_tokens)
+        for before, after in zip(
+            result["greedy"], reversed(result["reused"]), strict=True
+        ):
+            if before["output_ids"] != after["output_ids"]:
+                raise AssertionError(
+                    "Greedy generation changed after request-slot reuse"
+                )
+        if args.backend == "sglang":
+            receipt = engine.update_weights_from_disk(args.model)
+            result["reload_receipt"] = str(receipt)
+            if isinstance(receipt, tuple) and receipt[0] is not True:
+                raise AssertionError(f"Weight reload failed: {receipt}")
+            result["reloaded"] = generate(engine, prompts, args.decode_tokens)
+            if [r["output_ids"] for r in result["reloaded"]] != [
+                r["output_ids"] for r in result["greedy"]
+            ]:
+                raise AssertionError("Same-checkpoint reload changed greedy outputs")
+        result["status"] = "PASSED"
+    except Exception as error:
+        result.update(status="FAILED", error=str(error))
+        raise
+    finally:
+        Path(args.output).write_text(json.dumps(result, indent=2) + "\n")
+        if args.backend == "sglang":
+            engine.shutdown()
+
+
+def _compare(left, right):
+    if left["status"] != "PASSED" or right["status"] != "PASSED":
+        raise ValueError("Both backend probes must pass before comparing")
+    if left["model"] != right["model"]:
+        raise ValueError("Cannot compare different checkpoint paths")
+    if left["config_sha256"] != right["config_sha256"]:
+        raise ValueError("Cannot compare different checkpoint configurations")
+    if not left["fixed_continuation"] or not left["greedy"]:
+        raise ValueError("Cannot compare empty probe results")
+    cases = []
+    for a, b in zip(
+        left["fixed_continuation"], right["fixed_continuation"], strict=True
+    ):
+        if a["input_ids"] != b["input_ids"]:
+            raise ValueError("Cannot compare different tokenized inputs")
+        pairs = list(zip(a["input_logprobs"][1:], b["input_logprobs"][1:], strict=True))
+        if not pairs or not all(
+            x is not None and y is not None and math.isfinite(x) and math.isfinite(y)
+            for x, y in pairs
+        ):
+            raise ValueError("Missing or nonfinite selected-token logprobs")
+        error = max(abs(x - y) for x, y in pairs)
+        cases.append(
+            {
+                "tokens": len(a["input_ids"]),
+                "max_logprob_error": error,
+                "passed": error <= 0.08,
+            }
+        )
+    matches = []
+    for a, b in zip(left["greedy"], right["greedy"], strict=True):
+        if a["input_ids"] != b["input_ids"]:
+            raise ValueError("Greedy prompts differ")
+        matches.append(a["output_ids"] == b["output_ids"])
+    return {
+        "passed": all(c["passed"] for c in cases),
+        "cases": cases,
+        "greedy_exact_matches": matches,
+        "note": "Selected-token parity gate; greedy branches reported separately, not hidden. Not a full-vocabulary KL test.",
+    }
+
+
+def main():
+    p = argparse.ArgumentParser(description=__doc__)
+    p.add_argument("--backend", choices=("sglang", "vllm"))
+    p.add_argument("--model")
+    p.add_argument("--output", required=True)
+    p.add_argument(
+        "--lengths", nargs="+", type=int, default=[1, 3, 31, 127, 511, 2047, 3071]
+    )
+    p.add_argument("--decode-tokens", type=int, default=32)
+    p.add_argument("--concurrency", type=int, default=16)
+    p.add_argument(
+        "--attention-backend", choices=("triton", "flashinfer", "fa3"), default="triton"
+    )
+    p.add_argument("--compare", nargs=2)
+    args = p.parse_args()
+    if args.compare:
+        report = _compare(*(json.loads(Path(f).read_text()) for f in args.compare))
+        Path(args.output).write_text(json.dumps(report, indent=2) + "\n")
+        if not report["passed"]:
+            raise SystemExit(1)
+    elif args.model and args.backend:
+        _probe(args)
+    else:
+        p.error("Supply --compare LEFT RIGHT or --backend BACKEND --model CHECKPOINT")
+
+
+if __name__ == "__main__":
+    main()
