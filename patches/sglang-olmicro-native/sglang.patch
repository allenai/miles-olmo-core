index 0000000..6106e83
--- /dev/null
+++ b/python/sglang/srt/models/mainline_ladder.py
@@ -0,0 +1,319 @@
+"""Native TP1 Olmicro: batched GDN kernels, managed state and paged attention.
+
+There is no Transformers model forward or per-request Python cache. Checkpoint
+names are the release names; projections and depthwise filters are packed at load.
+"""
+
+from collections.abc import Iterable
+
+import torch
+from sglang.kernels.ops.activation.activation import (
+    silu_and_mul_with_activation_rounding,
+)
+from sglang.kernels.ops.attention.fla.layernorm_gated import RMSNorm as RMSNormGated
+from sglang.srt.configs.mainline_ladder import MainlineLadderConfig
+from sglang.srt.distributed import get_pp_group
+from sglang.srt.layers.layernorm import RMSNorm
+from sglang.srt.layers.logits_processor import LogitsProcessor
+from sglang.srt.layers.radix_attention import RadixAttention
+from sglang.srt.layers.radix_linear_attention import RadixLinearAttention
+from sglang.srt.model_loader.weight_utils import default_weight_loader
+from sglang.srt.runtime_context import get_parallel, get_server_args
+from torch import nn
+
+
+class MainlineLadderSiluAndMul(nn.Module):
+    """Fuse SwiGLU while preserving the release's BF16 SiLU intermediate."""
+
+    def forward(self, x):
+        return silu_and_mul_with_activation_rounding(x)
+
+
+class MainlineLadderMLP(nn.Module):
+    def __init__(self, config):
+        super().__init__()
+        self.gate_proj = nn.Linear(
+            config.hidden_size, config.intermediate_size, bias=False
+        )
+        self.up_proj = nn.Linear(
+            config.hidden_size, config.intermediate_size, bias=False
+        )
+        self.down_proj = nn.Linear(
+            config.intermediate_size, config.hidden_size, bias=False
+        )
+        self.act_fn = MainlineLadderSiluAndMul()
+        self.register_buffer(
+            "_gate_up_weight",
+            torch.empty(2 * config.intermediate_size, config.hidden_size),
+            persistent=False,
+        )
+
+    def refresh_packed_weights(self):
+        self._gate_up_weight.copy_(
+            torch.cat((self.gate_proj.weight, self.up_proj.weight))
+        )
+
+    def forward(self, x):
+        gate_up = nn.functional.linear(x, self._gate_up_weight)
+        return self.down_proj(self.act_fn(gate_up))
+
+
+class MainlineLadderGDN(nn.Module):
+    def __init__(self, config, layer_id):
+        super().__init__()
+        key_dim = config.linear_num_key_heads * config.linear_key_head_dim
+        value_dim = config.linear_num_value_heads * config.linear_value_head_dim
+        self.conv_dims = (key_dim, key_dim, value_dim)
+        self.q_proj = nn.Linear(config.hidden_size, key_dim, bias=False)
+        self.k_proj = nn.Linear(config.hidden_size, key_dim, bias=False)
+        self.v_proj = nn.Linear(config.hidden_size, value_dim, bias=False)
+        self.register_buffer(
+            "_qkv_weight",
+            torch.empty(2 * key_dim + value_dim, config.hidden_size),
+            persistent=False,
+        )
+        self.a_proj = nn.Linear(
+            config.hidden_size, config.linear_num_value_heads, bias=False
+        )
+        self.b_proj = nn.Linear(
+            config.hidden_size, config.linear_num_value_heads, bias=False
+        )
+        self.g_proj = nn.Linear(config.hidden_size, value_dim, bias=False)
+        self.o_proj = nn.Linear(value_dim, config.hidden_size, bias=False)
+        for name, dim in zip(("q_conv1d", "k_conv1d", "v_conv1d"), self.conv_dims):
+            setattr(
+                self,
+                name,
+                nn.Conv1d(
+                    dim, dim, config.linear_conv_kernel_dim, groups=dim, bias=False
+                ),
+            )
+        self.register_buffer(
+            "_conv_weights",
+            torch.empty(sum(self.conv_dims), config.linear_conv_kernel_dim),
+            persistent=False,
+        )
+        self.A_log = nn.Parameter(
+            torch.empty(config.linear_num_value_heads, dtype=torch.float32)
+        )
+        self.dt_bias = nn.Parameter(torch.empty(config.linear_num_value_heads))
+        self.o_norm = RMSNormGated(
+            config.linear_value_head_dim,
+            eps=1e-5,
+            activation="silu",
+            device=torch.get_device_module().current_device(),
+            dtype=torch.get_default_dtype(),
+        )
+        self.attn = RadixLinearAttention(
+            layer_id=layer_id,
+            num_q_heads=config.linear_num_key_heads,
+            num_k_heads=config.linear_num_key_heads,
+            num_v_heads=config.linear_num_value_heads,
+            head_q_dim=config.linear_key_head_dim,
+            head_k_dim=config.linear_key_head_dim,
+            head_v_dim=config.linear_value_head_dim,
+            conv_weights=self._conv_weights,
+            A_log=self.A_log,
+            dt_bias=self.dt_bias,
+        )
+        self.attn.beta_scale = 2.0 if config.linear_allow_neg_eigval else 1.0
+        self.attn.vllm_compatible = True
+
+    def refresh_conv_weights(self):
+        # Keep release parameter names for checkpoint loading and live publication;
+        # fuse the depthwise filters once per reload, never per request/token.
+        self._conv_weights.copy_(
+            torch.cat(
+                (self.q_conv1d.weight, self.k_conv1d.weight, self.v_conv1d.weight),
+                dim=0,
+            ).squeeze(1)
+        )
+
+    def refresh_packed_weights(self):
+        self.refresh_conv_weights()
+        self._qkv_weight.copy_(
+            torch.cat((self.q_proj.weight, self.k_proj.weight, self.v_proj.weight))
+        )
+
+    def forward(self, x, batch):
+        qkv = nn.functional.linear(x, self._qkv_weight)
+        out = self.attn(batch, mixed_qkv=qkv, a=self.a_proj(x), b=self.b_proj(x))
+        gate = self.g_proj(x)
+        out = self.o_norm(
+            out.reshape(-1, self.o_norm.weight.numel()),
+            gate.reshape(-1, self.o_norm.weight.numel()),
+        )
+        return self.o_proj(out.reshape(x.shape[0], -1))
+
+
+class MainlineLadderAttention(nn.Module):
+    def __init__(self, config, layer_id):
+        super().__init__()
+        self.heads = config.num_attention_heads
+        self.kv_heads = config.num_key_value_heads
+        self.head_dim = config.head_dim
+        size = self.heads * self.head_dim
+        kv_size = self.kv_heads * self.head_dim
+        self.q_proj = nn.Linear(config.hidden_size, size, bias=False)
+        self.k_proj = nn.Linear(config.hidden_size, kv_size, bias=False)
+        self.v_proj = nn.Linear(config.hidden_size, kv_size, bias=False)
+        self.register_buffer(
+            "_qkv_weight",
+            torch.empty(size + 2 * kv_size, config.hidden_size),
+            persistent=False,
+        )
+        self.qkv_sizes = (size, kv_size, kv_size)
+        self.o_proj = nn.Linear(size, config.hidden_size, bias=False)
+        self.q_norm = RMSNorm(
+            self.head_dim, eps=config.rms_norm_eps, cast_x_before_out_mul=True
+        )
+        self.k_norm = RMSNorm(
+            self.head_dim, eps=config.rms_norm_eps, cast_x_before_out_mul=True
+        )
+        if config.use_attention_gate:
+            self.attn_gate = nn.Linear(config.hidden_size, size, bias=False)
+        self.attn = RadixAttention(
+            self.heads,
+            self.head_dim,
+            self.head_dim**-0.5,
+            num_kv_heads=self.kv_heads,
+            layer_id=layer_id,
+        )
+
+    def refresh_packed_weights(self):
+        self._qkv_weight.copy_(
+            torch.cat((self.q_proj.weight, self.k_proj.weight, self.v_proj.weight))
+        )
+
+    def forward(self, x, batch):
+        q, k, v = nn.functional.linear(x, self._qkv_weight).split(
+            self.qkv_sizes, dim=-1
+        )
+        q = self.q_norm(q.reshape(-1, self.heads, self.head_dim))
+        k = self.k_norm(k.reshape(-1, self.kv_heads, self.head_dim))
+        v = v.reshape(-1, self.kv_heads, self.head_dim)
+        out = self.attn(q, k, v, batch).reshape(x.shape[0], -1)
+        if hasattr(self, "attn_gate"):
+            out = out * self.attn_gate(x).float().sigmoid().to(out.dtype)
+        return self.o_proj(out)
+
+
+class MainlineLadderDecoderLayer(nn.Module):
+    def __init__(self, config, layer_id):
+        super().__init__()
+        self.linear = config.layer_types[layer_id] == "linear_attention"
+        if self.linear:
+            self.linear_attn = MainlineLadderGDN(config, layer_id)
+        else:
+            self.self_attn = MainlineLadderAttention(config, layer_id)
+        self.input_layernorm = RMSNorm(
+            config.hidden_size, eps=config.rms_norm_eps, cast_x_before_out_mul=True
+        )
+        self.post_attention_layernorm = RMSNorm(
+            config.hidden_size, eps=config.rms_norm_eps, cast_x_before_out_mul=True
+        )
+        self.ffn_layernorm = RMSNorm(
+            config.hidden_size, eps=config.rms_norm_eps, cast_x_before_out_mul=True
+        )
+        self.post_feedforward_layernorm = RMSNorm(
+            config.hidden_size, eps=config.rms_norm_eps, cast_x_before_out_mul=True
+        )
+        self.mlp = MainlineLadderMLP(config)
+
+    def forward(self, x, batch):
+        mixer = self.linear_attn if self.linear else self.self_attn
+        x = x + self.post_attention_layernorm(mixer(self.input_layernorm(x), batch))
+        return x + self.post_feedforward_layernorm(self.mlp(self.ffn_layernorm(x)))
+
+
+class MainlineLadderModel(nn.Module):
+    def __init__(self, config):
+        super().__init__()
+        self.embed_tokens = nn.Embedding(config.vocab_size, config.hidden_size)
+        self.embed_norm = RMSNorm(
+            config.hidden_size,
+            eps=config.embedding_norm_eps,
+            cast_x_before_out_mul=True,
+        )
+        self.embed_scale = config.embed_scale
+        self.layers = nn.ModuleList(
+            MainlineLadderDecoderLayer(config, i)
+            for i in range(config.num_hidden_layers)
+        )
+        self.norm = RMSNorm(
+            config.hidden_size, eps=config.rms_norm_eps, cast_x_before_out_mul=True
+        )
+
+    def forward(self, input_ids, batch, input_embeds=None):
+        x = self.embed_tokens(input_ids) if input_embeds is None else input_embeds
+        x = self.embed_norm(x * self.embed_scale)
+        for layer in self.layers:
+            x = layer(x, batch)
+        return self.norm(x)
+
+
+class MainlineLadderForCausalLM(nn.Module):
+    def __init__(self, config: MainlineLadderConfig, quant_config=None, prefix=""):
+        super().__init__()
+        if get_parallel().tp_size != 1 or get_pp_group().world_size != 1:
+            raise ValueError("Native Olmicro currently requires TP1/PP1")
+        if quant_config is not None or torch.get_default_dtype() != torch.bfloat16:
+            raise ValueError("Native Olmicro currently requires unquantized BF16")
+        if config.hidden_act != "silu" or not config.use_head_qk_norm:
+            raise ValueError(
+                "Unsupported Olmicro activation or missing QK normalization"
+            )
+        if config.attention_bias or config.tie_word_embeddings:
+            raise ValueError("Unsupported biased or tied Olmicro checkpoint")
+        # Prefix-state sharing and graph capture need separate GPU qualification.
+        args = get_server_args()
+        if not args.disable_cuda_graph or not args.disable_radix_cache:
+            raise ValueError(
+                "Initial native qualification requires no CUDA graphs/prefix cache"
+            )
+        if getattr(args, "speculative_algorithm", None):
+            raise ValueError("Native Olmicro speculative decoding is not qualified")
+        self.config = config
+        self.model = MainlineLadderModel(config)
+        self.lm_head = nn.Linear(config.hidden_size, config.vocab_size, bias=False)
+        self.logits_processor = LogitsProcessor(config)
+
+    @torch.no_grad()
+    def forward(self, input_ids, positions, forward_batch, input_embeds=None):
+        if forward_batch.forward_mode.is_idle():
+            hidden = self.lm_head.weight.new_empty((0, self.config.hidden_size))
+        else:
+            hidden = self.model(input_ids, forward_batch, input_embeds)
+        return self.logits_processor(input_ids, hidden, self.lm_head, forward_batch)
+
+    def get_input_embeddings(self):
+        return self.model.embed_tokens
+
+    @torch.no_grad()
+    def load_weights(self, weights: Iterable[tuple[str, torch.Tensor]]) -> set[str]:
+        params = dict(self.named_parameters())
+        loaded = set()
+        packed_modules = set()
+        for name, weight in weights:
+            if name not in params:
+                raise ValueError(f"Unexpected Olmicro checkpoint tensor: {name}")
+            default_weight_loader(params[name], weight)
+            loaded.add(name)
+            component = name.rsplit(".", 2)[-2]
+            if component in (
+                "q_proj",
+                "k_proj",
+                "v_proj",
+                "gate_proj",
+                "up_proj",
+                "q_conv1d",
+                "k_conv1d",
+                "v_conv1d",
+            ):
+                packed_modules.add(name.rsplit(".", 2)[0])
+        for name in packed_modules:
+            self.get_submodule(name).refresh_packed_weights()
+        return loaded
+
+
+EntryClass = MainlineLadderForCausalLM
