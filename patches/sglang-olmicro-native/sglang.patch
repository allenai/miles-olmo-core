@@ -0,0 +1,44 @@
+"""Check the chunk solve against an independent small dense matrix inverse."""
+
+import pytest
+import torch
+from sglang.kernels.ops.attention.fla.chunk_fwd import chunk_gated_delta_rule_fwd_intra
+
+
+@pytest.mark.parametrize("length,compatible", [(7, False), (7, True), (31, True)])
+def test_gram_beta_rounding_and_triangular_inverse(length, compatible):
+    torch.manual_seed(73)
+    k = torch.randn(1, length, 2, 32, device="cuda", dtype=torch.bfloat16)
+    k = (k.float() / k.float().square().sum(-1, keepdim=True).sqrt()).to(k.dtype)
+    v = torch.randn_like(k)
+    beta = (
+        torch.linspace(-2, 2, length * 2, device="cuda").sigmoid().reshape(1, length, 2)
+        * 2
+    )
+    g = (-torch.rand(1, length, 2, device="cuda") * 0.05).cumsum(1)
+    _, _, actual = chunk_gated_delta_rule_fwd_intra(
+        k, v, g, beta, vllm_compatible=compatible
+    )
+    for head in range(2):
+        keys = k[0, :, head].double().cpu()
+        if compatible:
+            weighted = (
+                (k[0, :, head].float() * beta[0, :, head, None])
+                .to(k.dtype)
+                .double()
+                .cpu()
+            )
+            gram = weighted @ keys.T
+        else:
+            gram = (keys @ keys.T) * beta[0, :, head, None].double().cpu()
+        gates = g[0, :, head].double().cpu()
+        gram *= (gates[:, None] - gates[None, :]).exp()
+        identity = torch.eye(length, dtype=torch.float64)
+        expected = torch.linalg.solve_triangular(
+            identity + gram.tril(-1), identity, upper=False
+        ).to(k.dtype)
+        obtained = actual[0, :, head, :length].cpu()
+        assert (obtained == expected).float().mean().item() > 0.99
+        torch.testing.assert_close(
+            obtained.float(), expected.float(), rtol=0.01, atol=0.002
+        )
