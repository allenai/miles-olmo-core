@@ -0,0 +1,39 @@
+"""BF16 RMSNorm must match vLLM's cast-before-weight numerical contract."""
+
+import pytest
+import torch
+from sglang.kernels.ops.attention.fla.layernorm_gated import RMSNorm as RMSNormGated
+from sglang.kernels.ops.layernorm.rmsnorm_hf import rmsnorm_hf
+
+
+@pytest.mark.parametrize("width", [128, 1024, 2048])
+def test_rmsnorm_rounds_normalized_activation_before_weight_multiply(width):
+    torch.manual_seed(31)
+    x = torch.randn(32, width, device="cuda", dtype=torch.bfloat16)
+    weight = torch.empty(width, device="cuda", dtype=torch.bfloat16).uniform_(
+        0.25, 1.75
+    )
+    normalized = x.float() * (x.float().square().mean(-1, keepdim=True) + 1e-6).rsqrt()
+    expected = normalized.to(x.dtype) * weight
+    cast_after = (normalized * weight.float()).to(x.dtype)
+    actual = rmsnorm_hf(x, weight, 1e-6)
+    assert actual.dtype == torch.bfloat16
+    # Allow rare BF16 boundary cases from different FP32 reduction trees.
+    assert (actual == expected).float().mean().item() > 0.999
+    assert (cast_after != expected).float().mean().item() > 0.05
+
+
+@pytest.mark.parametrize("width", [128, 256])
+def test_gated_norm_preserves_fp32_gate_product(width):
+    torch.manual_seed(61)
+    x = torch.randn(257, width, device="cuda", dtype=torch.bfloat16)
+    gate = torch.randn_like(x) * 3
+    norm = RMSNormGated(width, device="cuda", dtype=torch.bfloat16, eps=1e-5)
+    with torch.no_grad():
+        norm.weight.uniform_(0.25, 1.75)
+    normalized = x.float() * (x.float().square().mean(-1, keepdim=True) + 1e-5).rsqrt()
+    expected = (
+        (normalized * norm.weight.float()) * (gate.float() * gate.float().sigmoid())
+    ).bfloat16()
+    actual = norm(x, gate)
+    assert (actual == expected).float().mean().item() > 0.9999
